# Токен вашего Telegram-бота (получите у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=

# API-ключ Google Gemini (бесплатно на https://aistudio.google.com/)
GEMINI_API_KEY=

# Модель Gemini (gemini-2.0-flash — самая быстрая, стабильная и с огромными лимитами)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
